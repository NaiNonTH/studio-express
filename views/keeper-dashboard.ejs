<%- contentFor('styleLink') %>
<link rel="stylesheet" href="/stylesheets/keeper.css">

<%- contentFor('body') %>
<div class="dashboard">
  <div class="box admin-header">
    <div>
        <h2>ระบบจัดการ Studio</h2>
        <p style="color: #666;">ยินดีต้อนรับผู้ดูแล: <%= user.name %></p>
    </div>
    <div style="display:flex; gap: 1rem;">
        <a href="/dashboard" class="button" style="background-color: #666;">กลับหน้าหลัก</a>
        <a href="/logout" class="button">ออกจากระบบ</a>
    </div>
  </div>

  <div class="box span admin-section">
    <h3>📊 สถิติการจอง 30 วันย้อนหลัง</h3>
    <% if (stats.length === 0) { %>
        <p class="note">ยังไม่มีข้อมูลการใช้งานในช่วง 30 วันที่ผ่านมา</p>
    <% } else { %>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ชื่อโซน</th>
                    <th>จำนวนครั้งที่จอง</th>
                </tr>
            </thead>
            <tbody>
                <% stats.forEach(function(stat) { %>
                    <tr>
                        <td><%= stat.zone_name %></td>
                        <td><%= stat.total_usage %> ครั้ง</td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } %>
  </div>

  <div class="box span admin-section">
    <h3>📅 ตารางการจองวันนี้ (<%= new Date().toLocaleDateString('th-TH') %>)</h3>
    <% if (bookings.length === 0) { %>
        <p class="note">วันนี้ไม่มีคิวการจอง</p>
    <% } else { %>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>เวลา</th>
                    <th>โซน</th>
                    <th>ชื่อผู้จอง</th>
                </tr>
            </thead>
            <tbody>
                <% bookings.forEach(function(item) { %>
                    <tr>
                        <td><%= new Date(item.datetime).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) %></td>
                        <td><%= item.zone_name %></td>
                        <td><%= item.user_name %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } %>
  </div>

  <div class="box span admin-section">
    <h3>🛠️ จัดการข้อมูลโซน</h3>
    <p class="note" style="text-align: left; margin-bottom: 1rem;">แก้ไขรายละเอียด หรือปิดปรับปรุงโซน (ไม่สามารถลบถาวรได้)</p>
    
    <% zones.forEach(function(zone) { %>
        <div class="admin-card">
            <form action="/dashboard/keeper/edit-zone" method="POST" class="edit-form">
                <input type="hidden" name="zone_id" value="<%= zone.zone_id %>">
                <div class="form-group" style="flex: 0.5;">
                    <label for=<%= zone.zone_id + "-zone_name"%>>ชื่อโซน</label>
                    <input type="text" name="zone_name"  id="<%= zone.zone_id + "-zone_name"%>" value="<%= zone.zone_name %>" required>
                </div>
                <div class="form-group" style="flex: 2;">
                    <label for=<%= zone.zone_id + "-zone_details"%>>รายละเอียด</label>
                    <input type="text" name="zone_details"  id="<%= zone.zone_id + "-zone_details"%>" value="<%= zone.zone_details %>" required>
                </div>
                <div class="form-group" style="flex: 0.5; min-width: auto;">
                    <label for=<%= zone.zone_id + "-is_open"%>>เปิดให้จอง?</label>
                    <input type="checkbox" name="is_open"  id="<%= zone.zone_id + "-is_open"%>" <%= zone.is_open ? 'checked' : '' %>>
                </div>

                <button type="submit">บันทึก</button>
            </form>
        </div>
    <% }); %>
  </div>

  <div class="box span admin-section">
    <h3>➕ เพิ่มโซนใหม่</h3>
    <div class="admin-card">
        <form action="/dashboard/keeper/add-zone" method="POST" class="edit-form">
            <div class="form-group" style="flex: 0.5;">
                <label for="zone_name">ชื่อโซน</label>
                <input type="text" name="zone_name" id="zone_name" placeholder="เช่น Studio A" required>
            </div>

            <div class="form-group" style="flex: 2;">
                <label for="zone_details">รายละเอียด</label>
                <input type="text" name="zone_details" id="zone_details" placeholder="รายละเอียดอุปกรณ์ หรือขนาดห้อง" required>
            </div>

            <div class="form-group" style="flex: 0.5; min-width: auto;">
                <label for="is_open">เปิดให้จอง?</label>
                <input type="checkbox" name="is_open" id="is_open" checked>
            </div>

            <button type="submit">เพิ่มโซน</button>
        </form>
    </div>
  </div>

  <form method="post" action="/dashboard/user/edit-password" class="box">
    <h2>รหัสผ่านใหม่</h2>
    <% if (target === "edit-password") { %>
      <ul class="error">
        <% for (const errorMessage of errorMessages) { %>
          <li><%=errorMessage %></li>
        <% } %>
      </ul>
      <% if (updated) { %>
       <p>อัพเดทรหัสผ่านสำเร็จ</p>
      <% } %>
    <% } %>
    <div>
      <label for="current_password">รหัสผ่านปัจจุบัน</label>
      <input type="password" name="current_password" id="current_password">
    </div>
    <div>
      <label for="new_password">รหัสผ่านใหม่</label>
      <input type="password" name="new_password" id="new_password">
      <p class="note">รหัสผ่านต้องยาวตั้งแต่ 8 ตัวอักษรขึ้นไป</p>
    </div>
    <div>
      <label for="confirm_password">กรอกรหัสผ่านใหม่อีกครั้ง</label>
      <input type="password" name="confirm_password" id="confirm_password">
    </div>
    <button>ส่งแก้ไขรายละเอียด</button>
  </form>
</div>